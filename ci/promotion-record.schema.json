{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kube-platform promotion record",
  "description": "What a release of kube-platform contains. Built by ci/promotion_record.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "images", "charts", "notScanned", "scanner"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "digest", "sources"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["rendered", "runtime"] }
          }
        }
      }
    },
    "charts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "repository", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "notScanned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "reason"],
        "properties": {
          "type": { "enum": ["grafana-plugin"] },
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scanner": {
      "description": "Left null by the record builder. The security gate fills these in.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "databaseUpdatedAt"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "databaseUpdatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
