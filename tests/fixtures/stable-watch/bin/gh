#!/usr/bin/env python3
"""Stand-in for the gh commands that ci/stable_watch.py runs. It keeps issues
and labels in $STUB_GH_STATE/state.json and logs every call to calls.log.
Release data comes from $STUB_RELEASES (a JSON list) and the directory
$STUB_RELEASE_FILES/<tag>/. $STUB_ATTEST=fail makes `attestation verify` fail. `gh api` prints the file $STUB_PULLS
(the pull requests of a commit).
"""
import json
import os
import shutil
import sys
from pathlib import Path

state_dir = Path(os.environ["STUB_GH_STATE"])
state_file = state_dir / "state.json"
state = json.loads(state_file.read_text()) if state_file.exists() else {"issues": [], "labels": []}
args = sys.argv[1:]
with open(state_dir / "calls.log", "a") as log:
    log.write(" ".join(args) + "\n")


def opt(name, many=False):
    values = [args[i + 1] for i, a in enumerate(args) if a == name and i + 1 < len(args)]
    return values if many else (values[0] if values else None)


def save():
    state_file.write_text(json.dumps(state))


def issue(number):
    return next(i for i in state["issues"] if i["number"] == int(number))


group, verb = args[0], args[1] if len(args) > 1 else ""
if group == "label" and verb == "create":
    if args[2] not in state["labels"]:
        state["labels"].append(args[2])
elif group == "issue" and verb == "list":
    wanted = opt("--label")
    items = [i for i in state["issues"] if wanted in i["labels"]]
    print(json.dumps([{k: i[k] for k in ("number", "title", "state", "body", "author")} for i in items]))
elif group == "issue" and verb == "create":
    missing = [l for l in opt("--label", True) if l not in state["labels"]]
    if missing:
        sys.exit(f"could not add label: '{missing[0]}' not found")
    number = max([i["number"] for i in state["issues"]] + [0]) + 1
    state["issues"].append({"number": number, "title": opt("--title"), "state": "OPEN", "labels": opt("--label", True),
                            "body": Path(opt("--body-file")).read_text(), "comments": [],
                            "author": {"login": "app/github-actions", "is_bot": True}})
    print(f"https://github.com/example/repo/issues/{number}")
elif group == "issue" and verb == "edit":
    issue(args[2])["body"] = Path(opt("--body-file")).read_text()
elif group == "issue" and verb == "comment":
    issue(args[2])["comments"].append(Path(opt("--body-file")).read_text())
elif group == "issue" and verb == "close":
    issue(args[2])["state"] = "CLOSED"
elif group == "issue" and verb == "reopen":
    issue(args[2])["state"] = "OPEN"
elif group == "release" and verb == "list":
    print(Path(os.environ["STUB_RELEASES"]).read_text())
elif group == "release" and verb == "download":
    src = Path(os.environ["STUB_RELEASE_FILES"]) / args[2] / opt("--pattern")
    shutil.copy(src, Path(opt("--dir")) / opt("--pattern"))
elif group == "api":
    print(Path(os.environ["STUB_PULLS"]).read_text())
elif group == "attestation" and verb == "verify":
    if os.environ.get("STUB_ATTEST") == "fail":
        sys.exit("verification failed: no matching attestation")
else:
    sys.exit(f"stand-in gh: unsupported {' '.join(args)}")
save()
