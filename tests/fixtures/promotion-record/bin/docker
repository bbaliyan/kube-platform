#!/usr/bin/env bash
# Stand-in for `docker buildx imagetools inspect REF --format ...`. It prints
# the digest that the test wrote for REF in $STUB_DIGESTS, one "REF DIGEST" per line.
# A reference that is name@digest is served with that digest, unless
# $STUB_MISSING lists the reference (one per line).
ref="$4"
[ "$1 $2 $3" = "buildx imagetools inspect" ] || exit 2
case "$ref" in
  *@sha256:*)
    if [ -n "${STUB_MISSING:-}" ] && grep -qxF "$ref" "$STUB_MISSING"; then
      echo "MANIFEST_UNKNOWN: $ref" >&2; exit 1
    fi
    printf '%s' "${ref##*@}"; exit 0 ;;
esac
digest="$(awk -v r="$ref" '$1 == r { print $2 }' "$STUB_DIGESTS")"
[ -n "$digest" ] || { echo "no such image: $ref" >&2; exit 1; }
printf '%s' "$digest"
